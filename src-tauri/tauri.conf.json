{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clippy",
  "version": "1.1.0",
  "identifier": "app.clippy.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "buddy",
        "url": "buddy.html",
        "title": "Clippy",
        "width": 150,
        "height": 190,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "focus": false,
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "deck",
        "url": "deck.html",
        "title": "Clippy Deck",
        "width": 224,
        "height": 600,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active",
          "radius": 18
        }
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Clippy Settings",
        "width": 620,
        "height": 720,
        "minWidth": 520,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "visible": false,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "chat",
        "url": "chat.html",
        "title": "Chat with Clippy",
        "width": 440,
        "height": 620,
        "minWidth": 360,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "visible": false,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "public.app-category.utilities",
    "shortDescription": "Desktop paperclip buddy with a private local Qwen chat",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/clippy-helper"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": null
    }
  }
}